# Database connection string with PostGIS support. The default matches docker-compose.yml (npm run setup).
# Production: size the pool per instance (connection_limit) so instances x limit stays under
# Postgres max_connections, or point at PgBouncer and add &pgbouncer=true.
# e.g. ...?schema=public&connection_limit=10&pool_timeout=10
DATABASE_URL="postgresql://postgres:password@localhost:5440/Pune_Tour_Guide?schema=public"

# Backend server port
PORT=3001

# Cryptographic key for JWT session tokens (REQUIRED in production)
# Generate a strong 32+ character random secret for production
JWT_SECRET="replace_with_a_secure_random_secret_min_32_characters"

# Redis URL. Optional in development; REQUIRED in production when running more than one
# instance (shared rate limits, OTP cooldowns, caches, SOS live-tracking fan-out).
REDIS_URL="redis://localhost:6390"

# Node Environment ('development' | 'production')
NODE_ENV="development"

# ── Pune Explorer additions (all optional in development) ──
REFRESH_TOKEN_TTL_DAYS=30
APP_URL="http://localhost:5050"
CORS_ORIGINS="http://localhost:5050"
SAFETY_SERVICE_URL="http://localhost:8010"
# Routing. The defaults are public DEMO servers (development only). Production: a provider
# or self-hosted OSRM with the western-India extract. OSRM_URL = car/auto, OSRM_FOOT_URL = walking.
OSRM_URL="https://router.project-osrm.org"
OSRM_FOOT_URL="https://routing.openstreetmap.de/routed-foot"
# 32-byte hex key for AES-256-GCM medical data (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MEDICAL_ENC_KEY=""
# SMS for SOS alerts, trip links, test alerts and OTP.
# console | msg91 | twilio  (console prints to the server log with the number masked and medical text removed).
# PRODUCTION MUST USE A REAL PROVIDER or SOS alerts will not reach contacts.
#   twilio: SMS_API_KEY="AccountSid:AuthToken", SMS_SENDER_ID="+1..." (sender number)
#   msg91:  SMS_API_KEY=<authkey>, plus one DLT-approved template per message kind:
#           MSG91_TEMPLATE_SOS / MSG91_TEMPLATE_SAFE / MSG91_TEMPLATE_TRIP / MSG91_TEMPLATE_TEST
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID=""
GOOGLE_CLIENT_ID=""
# Google Maps Platform server key (Places API (New) + Routes API only; never the browser key).
# Unset = photos, ratings and side quests are off. Then link places once: npm run google:link -w services/tour-api
GOOGLE_MAPS_SERVER_KEY=""
# Most Google calls per kind per day (Pune time), shared by all instances. details/nearby stay inside the free
# monthly amounts; photo (big photos) + thumb (row thumbnails, up to 480 px) = 400 a day, about 5,000 paid a month at most.
GOOGLE_DAILY_CAPS="details=230,nearby=230,photo=150,thumb=250"
EMAIL_API_KEY=""
EMAIL_FROM="Pune Explorer <no-reply@pune-explorer.app>"
CLOUDINARY_URL=""
WEATHER_API_KEY=""

# Background jobs (SMS queue on Redis via BullMQ). The API runs the worker unless RUN_WORKERS=false;
# at scale run `npm run worker -w services/tour-api` as its own process.
RUN_WORKERS=true
# SMS_QUEUE=inline sends without the queue (debugging only)
