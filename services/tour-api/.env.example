# Database connection string with PostGIS support.
# Production: size the pool per instance (connection_limit) so instances x limit stays under
# Postgres max_connections, or point at PgBouncer and add &pgbouncer=true.
# e.g. ...?schema=public&connection_limit=10&pool_timeout=10
DATABASE_URL="postgresql://postgres:password@localhost:5432/Pune_Tour_Guide?schema=public"

# Backend server port
PORT=3001

# Cryptographic key for JWT session tokens (REQUIRED in production)
# Generate a strong 32+ character random secret for production
JWT_SECRET="replace_with_a_secure_random_secret_min_32_characters"

# Redis URL. Optional in development; REQUIRED in production when running more than one
# instance (shared rate limits, OTP cooldowns, caches, SOS live-tracking fan-out).
REDIS_URL="redis://localhost:6379"

# Node Environment ('development' | 'production')
NODE_ENV="development"

# ── Pune Explorer additions (all optional in development) ──
REFRESH_TOKEN_TTL_DAYS=30
APP_URL="http://localhost:5050"
CORS_ORIGINS="http://localhost:5050"
SAFETY_SERVICE_URL="http://localhost:8000"
OSRM_URL="https://router.project-osrm.org"
# 32-byte hex key for AES-256-GCM medical data (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MEDICAL_ENC_KEY=""
# console | msg91 | twilio  (console prints SMS/OTP to the server log)
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID=""
GOOGLE_CLIENT_ID=""
EMAIL_API_KEY=""
EMAIL_FROM="Pune Explorer <no-reply@pune-explorer.app>"
CLOUDINARY_URL=""
WEATHER_API_KEY=""
