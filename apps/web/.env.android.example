# Android app build (vite build --mode android). Copy to .env.android and fill in.
# The app runs from https://localhost, so the API and safety service need full URLs.
# Also add https://localhost to the API's CORS_ORIGINS and the safety service's ALLOWED_ORIGINS.
VITE_API_BASE_URL=https://pune-explorer.example.com/api/v1
VITE_SAFETY_URL=https://pune-explorer.example.com/safety
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILES_OFFLINE=false
# Google's web sign-in does not run inside apps (Google blocks embedded browsers), so leave this
# empty: the app offers email and mobile sign-in.
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
