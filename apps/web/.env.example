# Tour API (Express) and Safety service (FastAPI).
# In development the Vite server proxies /api and /safety, so these defaults just work.
VITE_API_BASE_URL=/api/v1
VITE_SAFETY_URL=/safety
# Map tiles. Blank = the OSM public tile server, for DEVELOPMENT ONLY (its usage policy forbids
# app traffic). Production: a provider URL with your key, e.g.
#   https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=
# HTML attribution required by your tile provider
VITE_MAP_TILE_ATTRIBUTION=
# true ONLY if your tile provider's terms allow offline caching: offline packs then save map tiles.
# (Never with the OSM public server: its policy forbids bulk downloading.)
VITE_MAP_TILES_OFFLINE=false
# Google Identity Services client ID (Phase 7)
VITE_GOOGLE_CLIENT_ID=

# Shown on the Terms and Privacy pages as the contact for data requests (DPDP Act)
VITE_CONTACT_EMAIL=

# true only when the server's SMS provider reaches every Indian number (paid, DLT-registered sender).
# Off: phone-number login is hidden, and SOS / trip-share / test texts go from the person's own phone.
VITE_SERVER_SMS=false
