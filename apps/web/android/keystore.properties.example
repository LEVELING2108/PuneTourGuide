# Copy to keystore.properties (git-ignored) for release builds. Create the key once with:
#   keytool -genkeypair -v -keystore pune-explorer-upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Keep the .jks file and both passwords in a password manager: Play needs the same key for every update.
storeFile=pune-explorer-upload.jks
storePassword=
keyAlias=upload
keyPassword=
