# Production settings for deploy/docker-compose.prod.yml (and a checklist for any other host).
# deploy/server-setup.sh creates this file on the server with fresh secrets; otherwise copy it
# to .env.production and fill it in. NEVER commit the filled-in file.
# Each line points at its step in docs/LAUNCH_SETUP.md.

# ── Images and optional parts ───────────────────────────────────
# Ready-made images from GitHub Actions (lower-case owner). Leave as is to build locally instead.
APP_IMAGE=ghcr.io/leveling2108/pune-explorer-app:latest
SAFETY_IMAGE=ghcr.io/leveling2108/pune-explorer-safety:latest
# db = Postgres on this server (not with a managed database) · worker = separate SMS worker
COMPOSE_PROFILES=
RUN_WORKERS=true
# Small (1 GB) servers: NODE_OPTIONS=--max-old-space-size=256, SAFETY_WORKERS=1, REDIS_MAXMEMORY=64mb
NODE_OPTIONS=
SAFETY_WORKERS=2
REDIS_MAXMEMORY=256mb

# ── Domain (step 1) ─────────────────────────────────────────────
DOMAIN=pune-explorer.example.com
ACME_EMAIL=you@example.com
APP_URL=https://pune-explorer.example.com
CORS_ORIGINS=https://pune-explorer.example.com
RELEASE=2026.10.1

# ── Database (step 2) ───────────────────────────────────────────
# Managed (Azure, Neon, Supabase...): the provider's URL plus &sslmode=require, e.g.
# DATABASE_URL=postgresql://pune:PASSWORD@your-server.postgres.database.azure.com:5432/pune_explorer?schema=public&sslmode=require&connection_limit=5
# Self-hosted (COMPOSE_PROFILES=db):
POSTGRES_USER=pune
POSTGRES_PASSWORD=
POSTGRES_DB=pune_explorer
DATABASE_URL=postgresql://pune:CHANGE_ME@postgres:5432/pune_explorer?schema=public&connection_limit=10&pool_timeout=10

# ── Redis (step 3) ──────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ── Secrets (step 4) ────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   ← BACK THIS UP
MEDICAL_ENC_KEY=

# ── Help points (step 6) ────────────────────────────────────────
OVERPASS_ENDPOINTS=

# ── Map tiles (step 7): baked into the web build ────────────────
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILES_OFFLINE=false
# Hosts of VITE_MAP_TILE_URL for the Content-Security-Policy, e.g. https://api.maptiler.com
MAP_TILE_ORIGINS=https://api.maptiler.com

# ── Routing (step 8) ────────────────────────────────────────────
OSRM_URL=
OSRM_FOOT_URL=

# ── SMS (step 9) ────────────────────────────────────────────────
# console until a provider is ready (nothing is sent; the app still starts). Then twilio or msg91.
# A half-filled provider stops the app from starting, so SOS never fails silently.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
MSG91_TEMPLATE_SOS=
MSG91_TEMPLATE_SAFE=
MSG91_TEMPLATE_TRIP=
MSG91_TEMPLATE_TEST=
MSG91_TEMPLATE_OTP=

# ── Email (step 16) ─────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=Pune Explorer <no-reply@pune-explorer.example.com>

# ── Google sign-in (step 17): the same ID twice ─────────────────
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── Error reporting (step 19) ───────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_DSN=

# ── Logs ────────────────────────────────────────────────────────
LOG_LEVEL=info
